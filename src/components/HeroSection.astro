---
import StickyNav from "./StickyNav.astro";
import '../style.css'
---

<section class="hero-section">
    <StickyNav />
    <div class="img-wrapper">
      <div class="slideshow-wrapper">
         <div class="slides">
            <input type="radio" name="radio-btn" id="radio1">
            <input type="radio" name="radio-btn" id="radio2">
            <input type="radio" name="radio-btn" id="radio3">
            <input type="radio" name="radio-btn" id="radio4">
            <input type="radio" name="radio-btn" id="radio5">

            <div class="slide first">
               <img src="/assets/Intro-Pics/1.jpg" alt="woods intro image">
            </div>
            <div class="slide">
               <img src="/assets/Intro-Pics/2.jpg" alt="woods intro image">
            </div>
            <div class="slide">
               <img src="/assets/Intro-Pics/3.jpg" alt="woods intro image">
            </div>
            <div class="slide">
               <img src="/assets/Intro-Pics/4.jpg" alt="woods intro image">
            </div>
            <div class="slide">
               <img src="/assets/Intro-Pics/5.jpg" alt="woods intro image">
            </div>

            <div class="navigation-auto">
               <div class="auto-btn1"></div>
               <div class="auto-btn2"></div>
               <div class="auto-btn3"></div>
               <div class="auto-btn4"></div>
               <div class="auto-btn5"></div>
            </div>

            <div class="navigation-manual">
               <label for="radio1" class="manual-btn"></label>
               <label for="radio2" class="manual-btn"></label>
               <label for="radio3" class="manual-btn"></label>
               <label for="radio4" class="manual-btn"></label>
               <label for="radio5" class="manual-btn"></label>
            </div>

         </div>
      </div>
   </div>
   
</section>

<style>

 .img-wrapper {
   display: flex;
   justify-content: center;
   align-items: center;
   margin-block-start: 5rem;
   height: 650px;

   .slideshow-wrapper {
      width: 1200px;
      height: 650px;
      overflow: hidden;
   }
 }

 .slides {
   width: 500%;
   height: 650px;
   display: flex;
   position: relative;
   
   input {
      display: none;
   }
   
   .slide {
      width: 20%;

         img {
         object-fit: cover;
         width: 1200px;
         height: 650px;
         }

      }
   }

   .navigation-manual {
      position: absolute;
      width: 1200px;
      display: flex;
      justify-content: center;
      bottom: 40;
   }

   .manual-btn {
      border: 2px solid white;
      padding: 5px;
      border-radius: 10px;
      cursor: pointer;
      transition: 1s;
   }

   .manual-btn:not(:last-child) {
      margin-right: 40px;
   }

   .manual-btn:hover{
      background: white;
   }

   #radio1:checked ~ .first{
      margin-left: 0;

   }
   #radio2:checked ~ .first{
      margin-left: -20%;

   }
   #radio3:checked ~ .first{
      margin-left: -40%;

   }
   #radio4:checked ~ .first{
      margin-left: -60%;

   }
   #radio5:checked ~ .first{
      margin-left: -80%;

   }

   .navigation-auto {
      position: absolute;
      display: flex;
      width: 1200px;
      justify-content: center;
      bottom: 40;
   }

   .navigation-auto div {
      border: 2px solid white;
      padding: 5px;
      border-radius: 10px; 
      transition: 1s;
   }

   .navigation-auto div:not(:last-child){
      margin-right: 40px;
   }

   #radio1:checked ~ .navigation-auto .auto-btn1 {
      background: white;
   }
   #radio2:checked ~ .navigation-auto .auto-btn2 {
      background: white;
   }
   #radio3:checked ~ .navigation-auto .auto-btn3 {
      background: white;
   }
   #radio4:checked ~ .navigation-auto .auto-btn4 {
      background: white;
   }
   #radio5:checked ~ .navigation-auto .auto-btn5 {
      background: white;
   }

   @keyframes fadeInOut {
  0%, 100% {
    opacity: 0; /* Fully invisible at the start and end */
  }
  50% {
    opacity: 1; /* Fully visible right in the middle (2.5s) */
  }
}

</style>

