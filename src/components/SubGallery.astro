---
import type { ImageMetadata } from 'astro';
import SubMenuSelectedWork from "./SubMenuSelectedWork";

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,JPG,png,gif}', {eager: true, query: "?url", import: 'default'});
const imageUrls = Object.keys(images);
---

<SubMenuSelectedWork items={imageUrls} client:load></SubMenuSelectedWork>
<section class="bottom"></section>

<style>

    .bottom {
        height: 30px;
        width: 100%;
    }

</style>
