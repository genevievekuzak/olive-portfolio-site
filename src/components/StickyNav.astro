---
const email = "olive.stefanski@gmail.com";
const subject = "Inquiry from website";
---

<header>
    <a href="/" class="logo">Olive Stefanski</a>

    <button class="mobile-nav-toggle" aria-controls="primary-navigation" aria-expanded="false">

        <span class="sr-only">Menu</span>
    </button>

    <nav>
        <ul id="primary-navigation"
        data-visible="false" class="primary-navigation">
            <li><a href="/#selected-work">Selected Work</a></li>
            <li><a href="/about">About</a></li>
            <li><a href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}>Contact</a></li>
            <li><a class="instagram-logo" href="https://www.instagram.com/floatyplace/" target="_blank"><img src="/images/instagram-svgrepo-com.svg" alt="Instagram link"></a></li>
        </ul>
    </nav>
</header>

<script>
    const primaryNav = document.querySelector('.primary-navigation');
    const navToggle = document.querySelector('.mobile-nav-toggle');

    navToggle?.addEventListener('click', () => {
        const visible = primaryNav?.getAttribute('data-visible');
        
        if (visible === "false") {
            primaryNav?.setAttribute("data-visible", "true");
            navToggle?.setAttribute("aria-expanded", "true");
        } else if (visible === 'true') {
            primaryNav?.setAttribute("data-visible", "false" );
            navToggle?.setAttribute("aria-expanded", "false");
        }
    })

    
</script>

<style>

body {
    overflow-x: hidden;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 2rem;
    transition: all 0.45s ease-out;
    background-color: white;
    
}

.logo {
    font-size: 1.7rem;
    font-family: Gloock;
    transition: all 0.45s ease-in;
}

.mobile-nav-toggle {
    display: none;
    }

.sr-only {
    visibility: hidden;
}

ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: 1rem;
}

li {
     font-size: 1.1rem;
    transition: all 0.45s ease-out;
}

a {
    text-decoration: none;
    color: currentColor;
    display: flex;
    

    &:hover,
    &:focus-visible {
        color: var(--clr-blue);
    }
    
    img {
        width: 25px;
        height: auto;
        filter: invert(3%) sepia(12%) saturate(2248%) hue-rotate(223deg) brightness(97%) contrast(98%);
        
    }
}


@media screen and (max-width: 50em) {
   
    header {
        align-items: flex-start;
        padding: 0;
        background-color: white;
        height: 3.5rem;
    }

    .logo {
        padding: .75rem 1.3rem;
        font-size: clamp(15px, 4.6vw, 29px);
        width: 60%;

    }

    nav {
        width: 70vw;
        transform: translateX(100%);
        transition: transform 350ms ease;
    }

    nav:has(ul[data-visible="true"]) {
        transform: translateX(0%);
        
    }

    ul[data-visible="true"] {
        transform: translateX(0%);
    }

    ul {
        flex-direction: column;
        text-align: center;
        height: 100vh;
        padding-top: 18rem;
        gap: 2em;
        transform: translateX(100%);
        transition: transform 350ms ease;
        background-color: white;
        
        
        li {
            font-size: clamp(17px, 5vw, 28px);

            & img {
                margin-block-start: 1em;
                width: 40px;
            }
        }

    
    }

    .mobile-nav-toggle {
        position: absolute;
        z-index: 9999;
        display: block;
        background-image: url("/Hamburger_icon.svg");
        background-repeat: no-repeat;
        background-color: transparent;
        width: 1.9rem;
        aspect-ratio: 1; /* This says the width and the height are the same */
        border: 0;
        top: 0.6rem;
        right: 1.75rem;
        color: inherit;
        cursor: pointer;
    }

    .mobile-nav-toggle[aria-expanded = 'true'] {
        background-image: url("/x_icon.svg");
    }
}

@media screen and (min-width: 1500px) {
    header {
        padding: 1rem 3rem;

  
    }

    ul {
        li {
            font-size: 1.4rem;
        }
    }

    .logo {
        font-size: 2rem;
    }

    
}


</style>